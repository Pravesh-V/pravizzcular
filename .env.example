# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# IMPORTANT — client vs server secrets
# ------------------------------------
# Anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put a private key, service-role key, or AI provider
# key behind that prefix.
#
# Secrets (AI provider keys, Supabase service-role key) belong only to
# server-side code: a Supabase Edge Function or an API route. They are read
# from the server environment and never shipped to the device.

# --- Client-safe ---------------------------------------------------------
# Supabase project URL and anon key. The anon key is designed to be public and
# is only safe because row-level security is enabled on every table.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Which AI provider the app should request. One of: mock | openai | anthropic
# Defaults to `mock`, which needs no key and runs fully offline.
EXPO_PUBLIC_AI_PROVIDER=mock

# Base URL of the server that hosts the Pravesh Bot endpoint. The device calls
# this; the server holds the actual model credentials.
EXPO_PUBLIC_AI_ENDPOINT=

# --- Server-only — NEVER prefix these with EXPO_PUBLIC_ -------------------
# Set these in the Supabase Edge Function / hosting provider dashboard, not in
# any file that reaches the client bundle.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
